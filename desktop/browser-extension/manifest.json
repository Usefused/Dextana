{
  "manifest_version": 3,
  "name": "Dextana Browser",
  "version": "0.7.2",
  "description": "Connect an approved browser tab to Dextana, or transfer a website login.",
  "permissions": ["activeTab", "scripting", "storage", "debugger", "tabs", "downloads"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dextana Browser"
  },
  "key": "",
  "minimum_chrome_version": "118"
}
