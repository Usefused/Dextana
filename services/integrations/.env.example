PUBLIC_ORIGIN=http://127.0.0.1:8787
PORT=8787
HOST=127.0.0.1
DATA_DIR=var
FUSED_CLI_PATH=fused-cli
# Control credential for this service only; never configure this in the desktop.
FUSED_API_KEY=
# The exact bucket used by liveMCP, not a guessed/default bucket.
FUSED_BUCKET_ID=
# Local mode uses this explicit key; otherwise it uses the saved CLI login for catalog reads only.
DEXT_FUSED_CONTROL_KEY=
# Generated package entry point (after download/build), SDK execution token, and explicit gRPC origin.
FUSED_BILLING_SDK_MODULE=
FUSED_BILLING_SDK_TOKEN=
FUSED_ENGINE_GRPC_URL=
# Exact ingress URL returned by applying fused/webhook.yaml.
FUSED_STRIPE_WEBHOOK_URL=
FUSED_RECEIVER_NAME=dext-integrations-billing
# Separate admin credential; start:local creates var/admin-token when omitted.
ADMIN_TOKEN=
STRIPE_LIVE=false
RESEND_API_KEY=
MAIL_FROM=Dext Integrations <integrations@your-verified-domain>
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
