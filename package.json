{
  "name": "dextana",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop work assistant",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md docs .github",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "npm run backend:build && npm run build && electron .",
    "test": "vitest run",
    "test:backend": "node scripts/test-backend.mjs",
    "test:e2e": "npm run backend:build && npm run build && playwright test",
    "check": "npm run test && npm run test:e2e",
    "icons": "node scripts/generate-icons.mjs",
    "installer:artwork": "node scripts/generate-installer-artwork.mjs",
    "backend:build": "node scripts/build-backend.mjs",
    "pack": "npm run backend:build && npm run build && electron-builder --config electron-builder.adhoc.cjs --dir --publish never",
    "dist": "npm run backend:build && npm run build && electron-builder --config electron-builder.adhoc.cjs --publish never",
    "dist:signed": "node scripts/check-native-signing.mjs && npm run backend:build && npm run build && electron-builder --config electron-builder.signed.cjs --publish never && node scripts/verify-native-signing.mjs",
    "verify:artifacts": "node scripts/artifact-integrity.mjs verify",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:mac-installers": "node scripts/verify-macos-packaging.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "mermaid": "11.17.2",
    "pdfjs-dist": "5.5.207",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "productName": "Dextana",
  "author": "Fused"
}
